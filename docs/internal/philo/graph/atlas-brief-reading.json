        "edge.route.follow_through_board"
      ],
      "state_id": "state.desk_presentation.held_action_source",
      "applicability": "applicable",
      "preconditions": [
        "Fresh isolated HOME. Real Thought, Door task and snooze writes prepare the cited task; no model or provider."
      ],
      "setup": [
        {
          "kind": "ui",
          "action": "goto",
          "url": "/",
          "adapter": "ui-navigation"
        },
        {
          "kind": "ui",
          "action": "click_role",
          "role": "button",
          "name": "Continue later",
          "optional": true,
          "adapter": "ui-pointer"
        },
        {
          "kind": "api",
          "method": "POST",
          "path": "/api/thoughts",
          "body": {
            "request_id": "graph-brief-source",
            "raw_text": "Summarize what happened this week.",
            "initial_note": {
              "title": "Weekly summary source"
            }
          },
          "capture_as": "thought",
          "capture_path": "thought.id",
          "expect_status": 201,
          "adapter": "http-route"
        },
        {
          "kind": "api",
          "method": "POST",
          "path": "/api/door/items",
          "body": {
            "task": "Summarize what happened this week.",
            "owner": "Me",
            "source_type": "thought",
            "source_ref": "thought:{thought}"
          },
          "capture_as": "task",
          "capture_path": "item.id",
          "expect_status": 201,
          "adapter": "http-route"
        },
        {
          "kind": "api",
          "method": "POST",
          "path": "/api/follow-through/complete",
          "body": {
            "card_id": "{task}",
            "verb": "snooze",
            "payload": {
              "until": "2099-10-17"
            }
          },
          "adapter": "http-route"
        },
        {
          "kind": "api",
          "method": "POST",
          "path": "/api/notes",
          "body": {
            "title": "Source reading",
            "body_markdown": "Read [the held weekly summary](action_item:{task})."
          },
          "capture_as": "note",
          "capture_path": "note.id",
          "expect_status": 201,
          "adapter": "http-route"
        },
        {
          "kind": "ui",
          "action": "goto",
          "url": "/?open=note:{note}",
          "adapter": "ui-navigation"
        },
        {
          "kind": "ui",
          "action": "wait_for",
          "selector": "[id=\"pullout:note:{note}\"] .reading-ref",
          "adapter": "ui-pointer"
        }
      ],
      "trigger": {
        "kind": "ui",
        "action": "click",
        "selector": "[id=\"pullout:note:{note}\"] button.reading-ref",
        "adapter": "ui-pointer"
      },
      "expected": {
        "predicate": {
          "kind": "text_contains",
          "value": "Snoozed until"
        },
        "observe_at": "[id=\"pullout:intelligence:desk\"] .follow-through-facts",
        "words": "The exact canonical held task opens expanded with its stored hold date; the normal board remains suppressed."
      },
      "completion_bound_s": 30,

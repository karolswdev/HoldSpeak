          "state": "visible",
          "timeout_s": 20,
          "adapter": "ui-observation"
        }
      ],
      "trigger": {
        "kind": "ui",
        "action": "click",
        "adapter": "ui-by-viewport",
        "selector": ".conductor-window [data-object-id=\"coder:codex:{coder_session_id}\"] button.cw-row-title",
        "then": [
          {
            "kind": "ui",
            "action": "click",
            "selector": ".conductor-window button:has-text(\"Get Info\")",
            "adapter": "ui-by-viewport"
          },
          {
            "kind": "ui",
            "action": "click",
            "selector": ".conductor-info-window button:has-text(\"Open\")",
            "adapter": "ui-by-viewport"
          }
        ]
      },
      "expected": {
        "predicate": {
          "kind": "all_of",
          "predicates": [
            {
              "kind": "readable_text",
              "value": "Should I run the full suite now?"
            },
            {
              "kind": "selector_presence",
              "selector": ".is-session [data-testid=session-answer-well]",
              "present": true
            },
            {
              "kind": "selector_presence",
              "selector": ".is-session [data-testid=session-terminal]",
              "present": false
            },
            {
              "kind": "selector_presence",
              "selector": ".is-session details.desk-session-details[open]",
              "present": false
            }
          ]
        },

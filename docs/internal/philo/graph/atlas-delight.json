      "id": "case.delight.note.task",
      "job": "j11",
      "edge_ids": [
        "edge.face.note_task"
      ],
      "state_id": "state.desk_presentation.delight_note_task",
      "applicability": "applicable",
      "preconditions": [
        "The real Note producer creates a two-line note; keyboard selection chooses only its last line; no task is injected."
      ],
      "setup": [
        {
          "kind": "ui",
          "action": "goto",
          "url": "/",
          "adapter": "ui-navigation"
        },
        {
          "kind": "ui",
          "action": "click_role",
          "role": "button",
          "name": "Continue later",
          "optional": true,
          "adapter": "ui-by-viewport"
        },
        {
          "kind": "check",
          "predicate": {
            "kind": "protocol_field",
            "path": "arrival_required",

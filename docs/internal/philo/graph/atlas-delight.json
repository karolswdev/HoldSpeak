          "optional": true
        },
        {
          "kind": "api",
          "method": "PUT",
          "path": "/api/setup/onboarding",
          "adapter": "http-route",
          "body": {
            "disposition": "completed"
          },
          "expect_status": 200
        },
        {
          "kind": "api",
          "method": "POST",
          "path": "/api/setup/discover-models",
          "adapter": "http-route",
          "body": {
            "base_url": "{replay_provider_url}"
          },
          "expect_status": 200,
          "capture_as": "engine_model",
          "capture_path": "models.0"
        },
        {
          "kind": "api",
          "method": "POST",
          "path": "/api/inference/model-library/define-endpoint",
          "adapter": "http-route",
          "body": {
            "draft": {
              "request_id": "p11-06-model",
              "profile_id": "p11-recorded-engine",
              "expected_profile_revision": 0,
              "label": "Recorded loopback provider",
              "provider_family": "openai_compatible",
              "model": "{engine_model}",
              "endpoint": "{replay_provider_url}",
              "requires_key": false
            },
            "secret": null
          },
          "expect_status": 200,
          "capture_as": "profile_id",
          "capture_path": "provider.profile_id"
        },
        {
          "kind": "api",
          "method": "POST",
          "path": "/api/concierge/summary-selection",
          "adapter": "http-route",
          "body": {
            "commandId": "p11-06-summary",
            "expectedAssignmentRevision": 0,
            "profileId": "{profile_id}",
            "profileRevision": 1
          },
          "expect_status": 200
        },
        {
          "kind": "boundary",
          "label": "recorded meeting intelligence provider",
          "substitute": "engine_reply",
          "reply": "tests/fixtures/philo11_documents/meeting_summary_reply.json",
          "adapter": "hub-engine-boundary"
        },
        {
          "kind": "op",
          "name": "meeting.import",
          "args": {
            "path": "tests/fixtures/philo11_documents/meeting_transcript.vtt",
            "title": "Document source review"
          },
          "adapter": "mcp-http",
          "capture_as": "meeting_id",
          "capture_path": "meeting_id"
        },
        {
          "kind": "check",
          "observe_at": {
            "kind": "op",
            "name": "meeting.read",
            "args": {
              "meeting_id": "{meeting_id}"
            }
          },
          "predicate": {
            "kind": "op_field",
            "path": "transcription_status",
            "value": "complete"
          },
          "timeout_s": 30
        },
        {
          "kind": "check",
          "observe_at": {
            "kind": "op",
            "name": "meeting.read",
            "args": {
              "meeting_id": "{meeting_id}"
            }
          },
          "predicate": {
            "kind": "op_field",
            "path": "segments",
            "nonempty": true
          },
          "timeout_s": 30
        },
        {
          "kind": "op",
          "name": "meeting.read",
          "args": {
            "meeting_id": "{meeting_id}"
          },
          "adapter": "mcp-http",
          "capture_as": "selection_hash",
          "capture_path": "planned_route.selection_hash"
        },
        {
          "kind": "op",
          "name": "meeting.summary.run",
          "args": {
            "meeting_id": "{meeting_id}",
            "expected_selection_hash": "{selection_hash}"
          },
          "adapter": "mcp-http"
        },
        {
          "kind": "check",
          "observe_at": {
            "kind": "op",
            "name": "meeting.read",
            "args": {
              "meeting_id": "{meeting_id}"
            }
          },
          "predicate": {
            "kind": "op_field",
            "path": "intel.summary",
            "nonempty": true

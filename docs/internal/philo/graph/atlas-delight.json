          },
          "observe_at": "protocol: GET /api/setup/status",
          "timeout_s": 10,
          "why": "Wait for the real first-run dismissal before reload."
        },
        {
          "kind": "api",
          "method": "POST",
          "path": "/api/thoughts",
          "body": {
            "request_id": "delight-selected-note",
            "raw_text": "Migration notes\nWrite the rollback runbook",
            "initial_note": {
              "title": "Rollback note",
              "body_markdown": "Migration notes\nWrite the rollback runbook"
            }
          },
          "capture_as": "note_id",
          "capture_path": "thought.working_note.id",
          "adapter": "http-route"
        },
        {
          "kind": "ui",
          "action": "goto",
          "url": "/",
          "adapter": "ui-navigation"
        },
        {
          "kind": "ui",
          "action": "click",
          "selector": "button[aria-controls=desk-tool-shelf]",
          "adapter": "ui-pointer"
        },
        {
          "kind": "ui",
          "action": "fill",
          "selector": "input[aria-controls=desk-palette-listbox]",
          "value": "Rollback note",
          "adapter": "ui-pointer"
        },
        {
          "kind": "ui",
          "action": "click",
          "selector": "button.desk-deck-row:has-text(\"Rollback note\")",
          "adapter": "ui-pointer"
        },
        {
          "kind": "ui",
          "action": "wait_for",
          "selector": ".thought-note-foot",
          "adapter": "ui-pointer"
        },
        {
          "kind": "ui",
          "action": "focus",
          "selector": ".thought-note-body .cm-content",
          "adapter": "ui-keyboard"
        },
        {
          "kind": "ui",
          "action": "press",
          "selector": ".thought-note-body .cm-content",
          "key": "ControlOrMeta+End",
          "adapter": "ui-keyboard"
        },
        {
          "kind": "ui",
          "action": "press",
          "selector": ".thought-note-body .cm-content",
          "key": "Shift+Home",
          "adapter": "ui-keyboard"
        },
        {
          "kind": "ui",
          "action": "click",
          "selector": ".thought-note-foot button[aria-label=\"More actions\"]",
          "adapter": "ui-by-viewport",
          "at_width": 393,
          "why": "The phone keeps one primary; Task is in its More actions menu."
        }
      ],
      "trigger": {
        "kind": "ui",
        "action": "click",
        "selector": ".thought-note-foot button:has-text(\"Task\"), button[role=menuitem]:has-text(\"Task\")",
        "adapter": "ui-by-viewport",
        "then": [
          {
            "kind": "ui",
            "action": "wait_for",
            "selector": "[data-testid=thought-task-well]",
            "adapter": "ui-pointer"
          },
          {
            "kind": "ui",
            "action": "click",
            "selector": "[data-testid=thought-task-well] button:has-text(\"Add\")",
            "adapter": "ui-by-viewport"
          }
        ]
      },
      "expected": {
        "observe_at": "protocol: GET /api/door",
        "predicate": {
          "kind": "all_of",
          "predicates": [
            {
              "kind": "protocol_field",
              "path": "/board/waiting/0/text",
              "value": "Write the rollback runbook"
            },
            {
              "kind": "protocol_field",
              "path": "/board/waiting/0/source_ref",
              "value": "note:{note_id}"
            }
          ]
        },
        "words": "The actual Task/Add gesture creates the accepted task on the Door with the saved note as its source."
      },
      "completion_bound_s": 45,
      "viewports": [
        1440,
        393
      ]
    },

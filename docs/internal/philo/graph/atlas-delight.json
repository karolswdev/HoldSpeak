      "preconditions": [
        "The real import and bound summary producers run against the existing recorded loopback provider; this is controlled engine evidence, not a real LAN model."
      ],
      "setup": [
        {
          "kind": "ui",
          "action": "goto",
          "adapter": "ui-navigation",
          "url": "/"
        },
        {
          "kind": "ui",

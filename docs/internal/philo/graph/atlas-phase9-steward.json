     "name": "project.get_steward_run",
     "args": {
      "run_id": "{run_id}"
     }
    },
    "reads": [
     {
      "kind": "op",
      "name": "kernel.receipt.read",
      "args": {
       "operation_id": "{run_op}"
      }
     },
     {
      "kind": "op",
      "name": "project.list_updates",
      "args": {
       "project_id": "{project_id}"
      }
     }
    ],
    "words": "the start answers its run and its operation with no receipt yet; the run ends completed with ONE succeeded receipt that names the owner's policy operation; the draft effect wrote the update"

      {
       "source": "read",
       "index": 0,
       "path": "objects.0.native_receipts.0.configure_operation_id",
       "value": "{policy_op}"
      },
      {
       "source": "read",
       "index": 1,
       "path": "updates",
       "length": 1
      }
     ]
    },
    "observe_at": {

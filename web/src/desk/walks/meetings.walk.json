{
  "title": "Meetings",
  "open": {
    "app": "review-meetings",
    "scope": "@first-meeting"
  },
  "steps": [
    {
      "highlight": {
        "target": "meeting-mast",
        "thing": "meeting head",
        "words": "This is one meeting: its name, when it was and who was there.",
        "window": "pullout:meeting"
      }
    },
    {
      "highlight": {
        "target": "meeting-plate",
        "thing": "next step for this meeting",
        "words": "This matters now: the one thing to do with this meeting, with its button.",
        "window": "pullout:meeting"
      }
    },
    {
      "highlight": {
        "target": "meeting-ledger",
        "thing": "outcomes",
        "words": "Decisions and dated work carry weight. Each row has its own action.",
        "window": "pullout:meeting"
      }
    },
    {
      "highlight": {
        "target": "meeting-read-transcript",
        "thing": "transcript door",
        "words": "Read transcript opens the full text. Back returns to the ledger.",
        "window": "pullout:meeting"
      },
      "ask": {
        "ref": "meetings-feel",
        "question": "Is this how Meetings should feel?",
        "choices": [
          "Keep",
          "Redo"
        ]
      }
    }
  ]
}

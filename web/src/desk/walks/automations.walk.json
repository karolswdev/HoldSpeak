{
  "title": "Automations",
  "open": {
    "app": "surface-workbenches"
  },
  "steps": [
    {
      "highlight": {
        "target": "automation-home-rows",
        "thing": "automations",
        "words": "Press an automation to open it."
      }
    },
    {
      "highlight": {
        "target": "automation-sentence",
        "thing": "sentence",
        "words": "Press a part of this sentence to change it. New automations use the same sentence."
      }
    },
    {
      "highlight": {
        "target": "automation-run-now",
        "thing": "Run now",
        "words": "Run now starts this automation."
      }
    },
    {
      "highlight": {
        "target": "automation-result-list",
        "thing": "runs",
        "words": "The newest run comes first. Open result reads its answer."
      },
      "ask": {
        "ref": "automations-feel",
        "question": "Keep this Automations view?",
        "choices": [
          "Keep",
          "Redo"
        ]
      }
    }
  ]
}

{
  "title": "The Room",
  "open": {
    "app": "open-project-memory",
    "scope": "@first-project"
  },
  "steps": [
    {
      "highlight": {
        "target": "[data-testid=\"room-mast\"] .surface-mast-facts",
        "words": "Read the project’s state and what needs you here."
      }
    },
    {
      "highlight": {
        "target": "[data-testid=\"room-ask-well\"], [data-testid=\"room-head-ask\"]",
        "words": "Ask uses this project as context."
      }
    },
    {
      "highlight": {
        "target": "[data-testid=\"room-programs-new\"],[data-testid=\"room-open-programs\"]:not(:has([data-testid=\"room-programs-new\"])) [data-testid=\"room-open-programs-open\"]",
        "words": "Use this control to open Programs and start a job for this project."
      }
    }
  ],
  "review": {
    "ref": "room-feel",
    "question": "Keep this The Room view?",
    "choices": [
      "Keep",
      "Redo"
    ]
  }
}

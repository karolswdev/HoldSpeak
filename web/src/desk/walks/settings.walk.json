{
  "title": "Settings",
  "open": {
    "app": "surface-settings"
  },
  "steps": [
    {
      "highlight": {
        "target": "settings-rail",
        "thing": "settings list",
        "words": "Choose a part of Settings here. A dot marks a part that needs you."
      }
    },
    {
      "open": {
        "app": "surface-settings",
        "scope": "accounts"
      },
      "highlight": {
        "target": "settings-accounts",
        "thing": "accounts",
        "words": "Services, Calendars and Send to each have one tab. Select a row, then choose an action below it."
      }
    },
    {
      "open": {
        "app": "surface-settings",
        "scope": "engines"
      },
      "highlight": {
        "target": "settings-job-default",
        "thing": "engine order",
        "words": "Choose engines in the job row. Set order changes a longer chain. The saved order stays until your press."
      },
      "ask": {
        "ref": "settings-engines",
        "question": "Is the engine order clear?",
        "choices": [
          "Clear",
          "Unclear"
        ]
      }
    },
    {
      "highlight": {
        "target": "settings-engines",
        "thing": "engines",
        "words": "The lower list shows engines on this desk. Plus opens the model library."
      },
      "ask": {
        "ref": "settings-feel",
        "question": "Is this how Settings should feel?",
        "choices": [
          "Keep",
          "Redo"
        ]
      }
    }
  ]
}
